# ---- Servidor ----
NODE_ENV=development
PORT=4000
# Orígenes permitidos por CORS, separados por coma (la web de Next.js)
CORS_ORIGINS=http://localhost:3000

# ---- Base de datos ----
# Puerto 5433, que es el que expone docker-compose.yml para no chocar con una
# instalación de PostgreSQL que ya tengas en el 5432.
DATABASE_URL=postgres://nova:nova_dev@localhost:5433/nova

# ---- JWT ----
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-esto-por-una-cadena-aleatoria-de-32-o-mas-caracteres
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- IA (buscador conversacional) ----
# Clave gratuita en https://aistudio.google.com/apikey
# Si la dejas vacía, todo lo demás funciona; solo el asistente queda deshabilitado.
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash

# ---- Fanáticos 360 (/api/f360) ----
# Proveedor de datos: auto (api-football si hay clave, si no demo) | api-football | demo
F360_PROVEEDOR=auto
# Clave de https://dashboard.api-football.com (plan gratis: 100 consultas/día)
API_FOOTBALL_KEY=
# Ligas (IDs de API-Football): 239 Liga BetPlay, 241 Copa BetPlay, 1 Mundial, 13 Libertadores, 11 Sudamericana.
# El modo demo solo simula 239, 241 y 1. Con API-Football en vivo conviene 239,241,13:
# el Mundial 2026 ya terminó y solo tendría resultados.
F360_LIGAS=239,241,1
# Temporada (por defecto el año actual). El plan gratis puede no cubrir la actual.
# F360_TEMPORADA=2026
# Consultas máximas por día al proveedor (deja margen bajo el límite del plan)
F360_API_PRESUPUESTO_DIARIO=90
# pruebas = depósitos y retiros simulados. real exige licencia de Coljuegos y pasarela.
F360_PAGOS=pruebas
# F360_LICENCIA_COLJUEGOS=
# Token para un cron externo que llame POST /api/f360/ops/sync (mínimo 16 caracteres)
# F360_OPS_TOKEN=
