{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "local": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://172.28.176.1:4000",
        "EXPO_PUBLIC_WEB_URL": "http://172.28.176.1:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://nova-api-kappa.vercel.app",
        "EXPO_PUBLIC_WEB_URL": "https://voktersport.com"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://nova-api-kappa.vercel.app",
        "EXPO_PUBLIC_WEB_URL": "https://voktersport.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
