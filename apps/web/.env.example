# URL del backend de Vokter (Express)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Enlace directo al APK de la app móvil (EAS Build). Si está vacío, /download muestra "en construcción".
NEXT_PUBLIC_APK_URL=

# URL pública de esta web. La usa el QR de /download mientras no haya APK.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- App Fanáticos 360 (/download) ----
# Enlace directo al APK. APK_URL se lee al ejecutar (cámbiala y reinicia, sin
# reconstruir); NEXT_PUBLIC_APK_URL se congela en el build. Si las dos están
# vacías se usa la última versión de GitHub Releases:
#   https://github.com/Cachureto/VOKTER/releases/latest/download/fanaticos-360.apk
# El QR de /download siempre apunta a <este dominio>/download/apk, que
# redirige a este enlace: el QR no cambia aunque cambie el APK.
APK_URL=
